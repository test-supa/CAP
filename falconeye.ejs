    <script>
        function sendCommand(cmd) {
            $.post(baseURL + '/sendCommand', {
                command: cmd
            }, function(data) {
                if (data.success) {
                    showNotification('success', 'Command ' + cmd + ' sent successfully');
                } else {
                    showNotification('error', 'Failed to send command');
                }
            });
